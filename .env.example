# Telegram Bot API token from @BotFather
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Comma-separated Telegram User IDs of authorized administrators
ADMIN_USER_IDS=

# Database Connection URL (Async SQLite by default, PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./data/telegram.db

# Logging Configuration
LOG_LEVEL=INFO

# Concurrency & Transfer Tuning (scale up for higher CPU cores)
MAX_CONCURRENT_TRANSFERS=4
MAX_RETRY_ATTEMPTS=5
PROGRESS_UPDATE_INTERVAL=3

# Session Storage
SESSION_DIRECTORY=./data/sessions

# Web Server & Live Public Dashboard Port (Internal port 10000)
PORT=10000

# High-Performance Media Downloader & Uploader Tuning (allowed: 1, 2, 4, 8, 12, 16)
DOWNLOAD_WORKERS=16
UPLOAD_WORKERS=16
DOWNLOAD_REQUEST_SIZE=524288
MAX_DOWNLOAD_RETRIES=5
DOWNLOAD_PROGRESS_INTERVAL=3
DOWNLOAD_RESUME=true
DOWNLOAD_DIRECTORY=./downloads


