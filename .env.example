# Telegram Bot API token from @BotFather
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Comma-separated Telegram User IDs of authorized administrators
ADMIN_USER_IDS=

# Database Connection URL (Async SQLite by default, PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./data/telegram.db

# Logging Configuration
LOG_LEVEL=INFO

# Concurrency & Transfer Tuning
MAX_CONCURRENT_TRANSFERS=2
MAX_RETRY_ATTEMPTS=5
PROGRESS_UPDATE_INTERVAL=3

# Session Storage
SESSION_DIRECTORY=./data/sessions

